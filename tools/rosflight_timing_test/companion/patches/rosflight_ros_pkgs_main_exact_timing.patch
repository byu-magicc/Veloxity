+void ROSflightIO::handle_offboard_control_msg(const mavlink_message_t & msg)
+{
+  if (serial_delay_pub_ == nullptr) {
+    serial_delay_pub_ =
+      this->create_publisher<rosflight_msgs::msg::TimeDelay>("serial_time_delay_ns", 10);
+  }
+
+  mavlink_offboard_control_t offboard;
+  mavlink_msg_offboard_control_decode(&msg, &offboard);
+
+  rosflight_msgs::msg::TimeDelay output;
+  output.header.stamp = this->get_clock()->now();
+  const int64_t received_ns = this->get_clock()->now().nanoseconds() % timing_modulus_ns_;
+  const int64_t sent_ns =
+    static_cast<int64_t>(std::roundf(offboard.u[0])) * timing_split_ns_ +
+    static_cast<int64_t>(std::roundf(offboard.u[1]));
+  int64_t delay_ns = received_ns - sent_ns;
+  if (delay_ns < 0) {
+    delay_ns += timing_modulus_ns_;
+  }
+
+  output.time_delay_ns = static_cast<uint64_t>(delay_ns);
+  constexpr float id_scale = 16'777'216.0F;
+  output.sequence_id = static_cast<uint32_t>(std::roundf(offboard.u[2] * id_scale));
+  output.run_id = static_cast<uint32_t>(std::roundf(offboard.u[3] * id_scale));
+  serial_delay_pub_->publish(output);
+}
